{
  "manifest_version": 3,
  "name": "TBO Flight Search Interceptor",
  "version": "2.0",
  "description": "Captures flights-api.tbo.in flight search requests and paginates through all results automatically.",
  "permissions": [
    "webRequest",
    "storage",
    "downloads",
    "unlimitedStorage",
    "scripting",
    "activeTab",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://flights-api.tbo.in/*",
    "https://flights.tbo.in/*"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TBO Interceptor"
  },
  "icons": {
    "16": "icon16.png"
  }
}